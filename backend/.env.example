# Local development defaults. Render injects production values from render.yaml.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
JWT_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./psxviewai.db
COOKIE_SECURE=0

# Optional when the frontend is hosted on another origin (comma-separated).
CORS_ORIGINS=

# Fetch current economic news in a non-blocking background task.
NEWS_PIPELINE_ENABLED=0
NEWS_PIPELINE_INTERVAL_MINUTES=60
NEWS_PIPELINE_TIMEOUT_SECONDS=600
