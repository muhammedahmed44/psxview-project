# Local development defaults. Render injects production values from render.yaml.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
JWT_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./psxviewai.db
COOKIE_SECURE=0

# Optional when the frontend is hosted on another origin (comma-separated).
CORS_ORIGINS=

# Recommended cloud email provider (HTTPS, works on Render).
RESEND_API_KEY=
RESEND_FROM=PSXviewAI <onboarding@resend.dev>

# Optional SMTP fallback for local or SMTP-enabled hosts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@psxviewai.local
